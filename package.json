{
  "name": "dev-clean",
  "version": "0.2.0",
  "description": "Reviewable workspace cleanup plans, reversible quarantine and protected artifact discovery for JS, Python and Rust",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "dev-clean": "bin/dev-clean.js", "dev-clean-advanced": "bin/dev-clean-advanced.js" },
  "files": ["dist", "bin", "advanced", "docs"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "check:advanced": "node --check advanced/core.mjs && node --check advanced/cli.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "keywords": ["cli", "disk", "cleanup", "node_modules", "next.js", "quarantine", "monorepo", "rust", "python"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/CodnanBaig/dev-clean.git" },
  "bugs": { "url": "https://github.com/CodnanBaig/dev-clean/issues" },
  "homepage": "https://github.com/CodnanBaig/dev-clean#readme",
  "dependencies": {
    "chalk": "^5.4.1", "commander": "^13.1.0", "execa": "^9.5.2", "fast-glob": "^3.3.3",
    "inquirer": "^9.3.7", "micromatch": "^4.0.8", "ora": "^8.2.0", "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9", "@types/inquirer": "^9.0.7", "@types/node": "^22.13.1",
    "tsx": "^4.19.2", "typescript": "^5.7.3"
  }
}
